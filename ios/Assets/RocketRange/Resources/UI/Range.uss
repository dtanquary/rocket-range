.range-root { color: rgb(232, 234, 218); font-size: 17px; }
.viewport { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.safe { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.header { position: absolute; left: 0; top: 0; right: 0; height: 88px; padding-left: 28px; padding-right: 24px; background-color: rgba(20, 35, 31, .95); flex-direction: row; align-items: center; justify-content: space-between; }
.wordmark { font-size: 24px; -unity-font-style: bold; letter-spacing: 3px; }
.eyebrow { font-size: 12px; letter-spacing: 2px; color: rgb(191, 204, 179); margin-top: 8px; margin-bottom: 8px; }
.muted { font-size: 14px; color: rgb(182, 192, 172); white-space: normal; }
.panel { background-color: rgba(24, 40, 34, .94); border-left-color: rgba(188, 205, 162, .2); border-left-width: 1px; border-top-left-radius: 9px; border-top-right-radius: 9px; border-bottom-left-radius: 9px; border-bottom-right-radius: 9px; padding: 22px; }
.bench { position: absolute; left: 18px; top: 106px; bottom: 22px; width: 312px; }
.title { font-size: 28px; -unity-font-style: bold; margin-bottom: 16px; white-space: normal; }
.rocket-name { font-size: 29px; -unity-font-style: bold; margin-top: 14px; }
.specs { font-size: 16px; color: rgb(212, 217, 192); margin-top: 15px; margin-bottom: 18px; white-space: normal; }
.estimate { white-space: normal; font-size: 15px; margin-top: 18px; margin-bottom: 16px; color: rgb(208, 214, 184); }
.fine { white-space: normal; font-size: 12px; color: rgb(165, 180, 159); margin-top: 15px; }
.row { flex-direction: row; align-items: center; justify-content: space-between; }
.range-root .unity-button { min-height: 44px; border-top-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-right-width: 1px; border-top-color: rgba(188, 205, 162, .22); border-bottom-color: rgba(188, 205, 162, .22); border-left-color: rgba(188, 205, 162, .22); border-right-color: rgba(188, 205, 162, .22); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; background-color: rgba(53, 73, 58, .9); color: rgb(225, 231, 208); margin: 3px; padding-left: 14px; padding-right: 14px; font-size: 15px; }
.range-root .unity-button:hover { background-color: rgb(70, 89, 67); }
.range-root .unity-button:active { background-color: rgb(89, 102, 70); }
.range-root .unity-button:disabled { opacity: .4; }
.range-root .unity-button.outline { background-color: rgba(0, 0, 0, 0); }
.range-root .unity-button.selected { border-top-color: rgb(224, 189, 113); border-bottom-color: rgb(224, 189, 113); border-left-color: rgb(224, 189, 113); border-right-color: rgb(224, 189, 113); color: rgb(249, 218, 155); }
.engines { flex-direction: row; flex-wrap: wrap; }
.engine { width: 46%; height: 70px; flex-shrink: 0; white-space: normal; font-size: 15px; }
.telemetry { position: absolute; top: 115px; right: 26px; width: 210px; }
.altitude { font-size: 52px; margin-top: 8px; margin-bottom: 12px; }
.reading { font-size: 19px; margin-top: 5px; }
.phase { color: rgb(216, 204, 139); white-space: normal; font-size: 12px; margin-top: 20px; }
.weather { position: absolute; top: 116px; left: 365px; }
.camera-bar { position: absolute; bottom: 28px; left: 360px; flex-direction: row; padding: 5px; background-color: rgba(24, 40, 34, .88); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; }
.controller { position: absolute; bottom: 25px; right: 26px; width: 290px; }
.range-root .unity-button.primary { background-color: rgb(229, 196, 126); color: rgb(34, 45, 31); height: 55px; -unity-font-style: bold; margin-top: 15px; }
.range-root .unity-button.primary:hover { background-color: rgb(246, 217, 154); }
.small { font-size: 12px; min-height: 36px; padding-left: 8px; padding-right: 8px; }
.hidden { display: none; }
.scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(7, 14, 11, .7); align-items: center; justify-content: center; }
.dialog { width: 820px; max-width: 92%; max-height: 88%; background-color: rgb(25, 42, 35); padding: 28px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-left-radius: 14px; border-bottom-right-radius: 14px; }
.fleet-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.fleet-card { width: 225px; height: 145px; -unity-text-align: middle-left; border-top-width: 5px; white-space: normal; padding: 15px; }
.body { white-space: normal; font-size: 16px; margin-bottom: 22px; margin-top: 15px; }
.setting { margin-bottom: 18px; }
.unity-base-slider { min-height: 44px; }
.compact .location { display: none; }
.compact .bench { width: 270px; top: 100px; padding: 16px; }
.compact .engine { width: 46%; font-size: 13px; }
.compact .weather { left: 310px; }
.compact .telemetry { width: 170px; padding: 15px; }
.compact .altitude { font-size: 38px; }
.compact .controller { width: 252px; padding: 16px; }
.compact .camera-bar { left: 310px; bottom: 24px; }
.compact .camera-bar .unity-button { padding-left: 8px; padding-right: 8px; font-size: 13px; }
.compact .title { font-size: 24px; }

.range-root .unity-button { background-image: none; }
.range-root .unity-button.armed { background-color: rgb(193, 76, 49); color: rgb(255, 242, 218); border-top-color: rgb(239, 138, 86); }
.range-root .unity-button.armed:hover { background-color: rgb(215, 91, 58); }
.range-root .unity-scroller--vertical { width: 12px; min-width: 12px; }
.range-root .unity-scroller .unity-repeat-button { display: none; }
.range-root .unity-scroller .unity-base-slider__tracker { background-color: rgba(125, 151, 124, .12); }
.range-root .unity-scroller .unity-base-slider__dragger { background-color: rgb(114, 139, 112); border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0; }
